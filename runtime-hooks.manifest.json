{
  "schema_version": 3,
  "service": "truealpha/app",
  "checks": [
    {
      "id": "smoke",
      "argv": [
        "sh",
        "-c",
        "uv run python -m truealpha_tools.health_probe --url \"$APP_URL/api/health\" --expected-version \"$APP_VERSION_REF\" --expect-data-engine-version \"$APP_VERSION_REF\" --max-attempts 36 --interval-seconds 5 --no-follow-redirects"
      ],
      "needs": [
        "running_service"
      ],
      "writes": false,
      "accepts_scale": false,
      "timeout_seconds": 120
    },
    {
      "id": "health",
      "argv": [
        "sh",
        "-c",
        "uv run python -m truealpha_tools.health_probe --url \"$APP_URL/api/health\" --expected-version \"$APP_VERSION_REF\" --expect-data-engine-version \"$APP_VERSION_REF\" --max-attempts 12 --interval-seconds 5 --no-follow-redirects"
      ],
      "needs": [
        "running_service"
      ],
      "writes": false,
      "accepts_scale": false,
      "timeout_seconds": 90,
      "cells": {
        "remove": {
          "scheduled_audit": {
            "reason": "The nightly audit reads /api/health in nightly_verdicts; a second health wait adds nothing.",
            "issue": "wangzitian0/truealpha#1745"
          }
        }
      }
    },
    {
      "id": "warm_surface",
      "argv": [
        "sh",
        "-c",
        "bash tools/warm_surface.sh \"$APP_URL\" / /research/rankings"
      ],
      "needs": [
        "running_service"
      ],
      "writes": false,
      "accepts_scale": false,
      "timeout_seconds": 30,
      "cells": {
        "remove": {
          "prod.post": {
            "reason": "Warming and walking the surface logs in with Staging test accounts; production runs the health check only.",
            "issue": "wangzitian0/truealpha#1745"
          },
          "scheduled_audit": {
            "reason": "Warming and walking the surface logs in with Staging test accounts; production runs the health check only.",
            "issue": "wangzitian0/truealpha#1745"
          }
        }
      }
    },
    {
      "id": "walk_tree",
      "argv": [
        "sh",
        "-c",
        "cd apps/app-web || exit 1; exec node e2e/walk-tree.mjs"
      ],
      "needs": [
        "running_service"
      ],
      "writes": false,
      "accepts_scale": false,
      "timeout_seconds": 240,
      "bootstrap": "cd apps/app-web && bun install --frozen-lockfile && bunx playwright install --only-shell chromium",
      "required_env": [
        "TA_EMAIL",
        "TA_MEMBER_EMAIL",
        "TA_PASSWORD",
        "TA_MCP_TOKEN"
      ],
      "cells": {
        "remove": {
          "prod.post": {
            "reason": "Warming and walking the surface logs in with Staging test accounts; production runs the health check only.",
            "issue": "wangzitian0/truealpha#1745"
          },
          "scheduled_audit": {
            "reason": "Warming and walking the surface logs in with Staging test accounts; production runs the health check only.",
            "issue": "wangzitian0/truealpha#1745"
          }
        }
      }
    },
    {
      "id": "nightly_verdicts",
      "argv": [
        "sh",
        "-c",
        "uv run python -m truealpha_tools.nightly_verdicts \"$APP_URL/api/health\" --environment \"$ENVIRONMENT\" --repo ."
      ],
      "needs": [
        "running_service"
      ],
      "writes": false,
      "accepts_scale": false,
      "timeout_seconds": 600,
      "bootstrap": "uv sync --frozen",
      "checkout_lineage": true,
      "cells": {
        "remove": {
          "preview.post": {
            "reason": "The nightly verdict audit runs on the schedule only.",
            "issue": "wangzitian0/truealpha#1745"
          },
          "staging.post": {
            "reason": "The nightly verdict audit runs on the schedule only.",
            "issue": "wangzitian0/truealpha#1745"
          },
          "prod.post": {
            "reason": "The nightly verdict audit runs on the schedule only.",
            "issue": "wangzitian0/truealpha#1745"
          }
        }
      }
    }
  ]
}
