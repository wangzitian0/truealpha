{
  "schema_version": 3,
  "service": "truealpha/app",
  "checks": [
    {
      "id": "smoke",
      "argv": [
        "sh",
        "-c",
        "python3 -m infra2_sdk.delivery poll --url \"$APP_URL/api/health\" --expected-version \"$APP_VERSION_REF\" --timeout-seconds 120 --interval-seconds 5"
      ],
      "needs": [
        "code",
        "running_service"
      ],
      "writes": false,
      "accepts_scale": false,
      "timeout_seconds": 120
    },
    {
      "id": "health",
      "argv": [
        "sh",
        "-c",
        "python3 -m infra2_sdk.delivery poll --url \"$APP_URL/api/health\" --expected-version \"$APP_VERSION_REF\" --timeout-seconds 60 --interval-seconds 5"
      ],
      "needs": [
        "code",
        "running_service"
      ],
      "writes": false,
      "accepts_scale": false,
      "timeout_seconds": 90,
      "cells": {
        "remove": {
          "scheduled_audit": {
            "reason": "The nightly audit reads /api/health in nightly_verdicts; a second health wait adds nothing.",
            "issue": "wangzitian0/truealpha#1745"
          }
        }
      }
    },
    {
      "id": "walk_tree",
      "argv": [
        "sh",
        "-c",
        "cd apps/app-web || exit 1; exec node e2e/walk-tree.mjs"
      ],
      "needs": [
        "running_service"
      ],
      "writes": false,
      "accepts_scale": false,
      "timeout_seconds": 240,
      "bootstrap": "cd apps/app-web && bun install --frozen-lockfile && bunx playwright install --only-shell chromium",
      "required_env": [
        "TA_EMAIL",
        "TA_MEMBER_EMAIL",
        "TA_PASSWORD"
      ],
      "cells": {
        "remove": {
          "prod.post": {
            "reason": "Warming and walking the surface logs in with Staging test accounts; production runs the health check only.",
            "issue": "wangzitian0/truealpha#1745"
          },
          "scheduled_audit": {
            "reason": "Warming and walking the surface logs in with Staging test accounts; production runs the health check only.",
            "issue": "wangzitian0/truealpha#1745"
          }
        }
      }
    },
    {
      "id": "nightly_verdicts",
      "argv": [
        "sh",
        "-c",
        "uv run python -m truealpha_tools.nightly_verdicts \"$APP_URL/api/health\" --environment \"$ENVIRONMENT\" --repo ."
      ],
      "needs": [
        "running_service"
      ],
      "writes": false,
      "accepts_scale": false,
      "timeout_seconds": 600,
      "bootstrap": "uv sync --frozen",
      "checkout_lineage": true,
      "cells": {
        "remove": {
          "preview.post": {
            "reason": "The nightly verdict audit runs on the schedule only.",
            "issue": "wangzitian0/truealpha#1745"
          },
          "staging.post": {
            "reason": "The nightly verdict audit runs on the schedule only.",
            "issue": "wangzitian0/truealpha#1745"
          },
          "prod.post": {
            "reason": "The nightly verdict audit runs on the schedule only.",
            "issue": "wangzitian0/truealpha#1745"
          }
        }
      }
    },
    {
      "id": "prod_surface",
      "argv": [
        "sh",
        "-c",
        "PYTHONPATH=common/runtime/src python -m truealpha_tools.prod_surface"
      ],
      "needs": [
        "running_service"
      ],
      "writes": false,
      "accepts_scale": false,
      "timeout_seconds": 60,
      "cells": {
        "remove": {
          "preview.post": {
            "reason": "Preview verifies the web surface with walk_tree.",
            "issue": "wangzitian0/infra2#1877"
          },
          "staging.post": {
            "reason": "Staging verifies the web surface with walk_tree.",
            "issue": "wangzitian0/infra2#1877"
          },
          "scheduled_audit": {
            "reason": "The nightly audit already reads /api/health in nightly_verdicts.",
            "issue": "wangzitian0/infra2#1877"
          }
        }
      }
    }
  ]
}
