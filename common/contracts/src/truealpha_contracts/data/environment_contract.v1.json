  "run_time_bounds": {
    "description": "The maximum runtime of every deployed Dagster job (#1442). Bound = margin x the longest successful run over all measured environments, and never below floor_minutes. A job that never ran takes live_tick_fit at the largest listing count of its tick. The run launcher writes the bound to the run tag dagster/max_runtime. The run monitor fails a run that exceeds its bound. The bound starts from the longest success, not from p95: p95 x 2 ends real successes (staging head_reports_pipeline: p95 5.3 min, longest success 22.5 min). The floor keeps scheduler jitter and lock waits from ending a short job; it is five run-monitor polls of 2 minutes.",
    "margin": 2,
    "floor_minutes": 10,
    "measured_at": "2026-10-20",
    "window_days": 30,
    "source": "dagster.runs of production and staging, SUCCESS runs, read-only SQL: https://github.com/wangzitian0/truealpha/issues/1442#issuecomment-6287671274",
    "live_tick_fit": {
      "intercept_minutes": 2.1,
      "minutes_per_listing": 0.434,
      "source": "fit through the TOPT and QQQ ticks: https://github.com/wangzitian0/truealpha/issues/1418#issuecomment-6286329834"
    },
